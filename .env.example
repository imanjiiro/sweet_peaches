# Скопируйте в .env (файл .env в git не попадает):
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
# Безопасно по умолчанию: без .env отладка выключена и ключа нет — проект не стартует без SECRET_KEY.

# Ключ подписи сессий. Для своей машины подойдёт любой; на сервере — длинный случайный, не из этого файла.
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=local-dev-key-replace-me

# Отладка ТОЛЬКО на своей машине (подробные ошибки, статика админки). На сервере: 0. Включается только значением 1.
DEBUG=1

ALLOWED_HOSTS=localhost,127.0.0.1

# Заезд 2 (по желанию)
# USE_QUEUE=1
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgres://user:pass@host:5432/dbname
